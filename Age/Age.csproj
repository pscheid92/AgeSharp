<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>AgeSharp</PackageId>
    <AssemblyName>AgeSharp</AssemblyName>
    <RootNamespace>AgeSharp</RootNamespace>
    <Authors>pscheid92</Authors>
    <Description>A C# implementation of the age file encryption format</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/pscheid92/AgeSharp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/pscheid92/AgeSharp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>age;encryption;cryptography</PackageTags>
  </PropertyGroup>

  <!-- Test hook: `dotnet test -p:ForcePortableAead=true` builds the library with the managed
       ChaCha20-Poly1305 backend and BouncyCastle's P-256 as the defaults, so the suite exercises
       the browser/WASM path.
       Never defined in a normal or packaged build. -->
  <PropertyGroup Condition="'$(ForcePortableAead)' == 'true'">
    <DefineConstants>$(DefineConstants);FORCE_PORTABLE_AEAD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Age.Tests" />
    <InternalsVisibleTo Include="Age.Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

    <PropertyGroup>
        <!-- RS0026: "do not add multiple overloads with optional parameters". Recipients.Encrypt
             (and, from step 4c, Identities.Decrypt) has a stream form and a bytes form, both
             taking optional options. The rule guards against ambiguous overload resolution and
             against baking a default into caller binaries; neither applies. The two forms differ
             in their first parameter (Stream against ReadOnlySpan<byte>), so they never compete,
             and the only default is null, resolved inside the method, so changing what a
             default means never needs callers recompiled. -->
        <NoWarn>$(NoWarn);RS0026</NoWarn>
    </PropertyGroup>

</Project>
