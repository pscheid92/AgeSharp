<Project Sdk="Microsoft.NET.Sdk">

  <!-- A mutation fuzzer over AgeSharp's parsers and the plugin protocol (see README.md). It is
       built with the solution, so it keeps compiling against the library, but not run by the
       tests; README.md says how to run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Age\Age.csproj" />
  </ItemGroup>

</Project>
