<Project Sdk="Microsoft.NET.Sdk">

  <!-- An age plugin built on AgePlugin, for the interop tests: other implementations' clients
       (go-age's age, rage) and AgeSharp's own run it as age-plugin-agesharptest. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>age-plugin-agesharptest</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Age\Age.csproj" />
  </ItemGroup>

</Project>
